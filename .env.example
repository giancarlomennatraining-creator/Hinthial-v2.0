# HINTHIAL --- environment variables (example)
#
# Copy this file to .env.local and fill in real values.
# Never commit .env.local or any file containing real secrets.

# Supabase (see FASE 2 --- Auth + database)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-side only. Never expose to the client / never prefix with NEXT_PUBLIC_.
# Used by tests/unit/rls.integration.test.ts and tests/e2e/ to create/delete
# throwaway test users via the admin API, and by the app itself for account
# deletion (src/lib/account/actions.ts --- auth.admin.deleteUser).
SUPABASE_SERVICE_ROLE_KEY=

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Server-side only. Used for the emails Hinthial sends itself (contact
# invite, account deletion/reset confirmation) via the Resend REST API ---
# distinct from Supabase Auth's own emails (signup confirmation, password
# reset), which stay configured in the Supabase dashboard. EMAIL_FROM must
# be on a domain verified in your Resend account.
RESEND_API_KEY=
EMAIL_FROM=

# e2e only (optional): a real, deliverable-to email address, needed only by
# the one e2e test that exercises the real signUp() UI flow end to end.
# See README.md --- FASE 2 for why this has to be a real address you own.
E2E_REGISTRATION_TEST_EMAIL=

# Server-side only. Never expose to the client / never prefix with NEXT_PUBLIC_.
# FASE 11 --- HINTHIAL AI reale, modalità "Explicit AI processing" (v.
# HINTHIAL_MVP.md sezione 8): usata solo da src/app/api/ai/chat/route.ts per
# generare risposte vere, e solo per gli utenti che hanno dato il consenso
# esplicito nella pagina AI --- senza questa chiave l'app resta comunque
# funzionante, usando solo il motore locale (mockAIProvider). Ottienila da
# https://console.anthropic.com.
ANTHROPIC_API_KEY=
